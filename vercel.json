{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/v1/fact-check/ping",
      "destination": "/api/v1/fact-check/ping"
    },
    {
      "source": "/api/v1/fact-check",
      "destination": "/api/v1/fact-check"
    },
    {
      "source": "/api/v1/health",
      "destination": "/api/v1/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
